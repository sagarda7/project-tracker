# Real values for the production deployment. Gitignored — never commit this file.

# DB_PROVIDER=postgres

# --- mysql option (kept for reference — not used while DB_PROVIDER=postgres above) ---
# Run `docker network ls` on the server and put the real network name here —
# it's the other stack's compose project name + "_shared_network". Only read when
# DB_PROVIDER commented and if we want sqlite
# --- sqlite option (for local development) ---
# DB_PROVIDER=sqlite
# DATABASE_URL="file:./dev.db"

# DB_PROVIDER=mysql.
# SHARED_NETWORK_NAME=wordpress-docker_shared_network
# mariadb has no host-published port; "mariadb" below is the container name, resolved
# via the shared Docker network.
# DATABASE_URL=mysql://user:password@mariadb:3306/dbname

# --- postgres option (Supabase) — DB_PROVIDER=postgres above uses this ---
# FIXME: this looks malformed — there are three "@" in a row before the host, which
# means the password segment likely has an un-encoded "@" in it (Supabase passwords with
# special characters need percent-encoding: @ -> %40, : -> %3A, etc., or the URL parses
# into the wrong password/host). Get the connection string fresh from Supabase's
# dashboard (Settings > Database > Connection string, URI tab, "show password") and
# paste it in exactly — don't hand-edit it.
# DATABASE_URL=postgresql://******

# --- File uploads (photos/documents) ---
# Only relevant on Vercel — local dev and Docker always write to public/uploads (see
# lib/storage.ts) since they have a real, writable filesystem. Vercel's deployed functions
# don't (read-only, and even /tmp there is ephemeral per-invocation), so uploads instead go
# to Vercel Blob. Enable it once in the Vercel dashboard (Storage tab -> Create -> Blob) and
# it auto-injects BLOB_READ_WRITE_TOKEN as a project env var — you don't set this yourself
# for a real deployment. lib/storage.ts picks the Blob-backed provider automatically whenever
# this variable is present, so leave it unset here/in .env for normal local development.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App ---
AUTH_SECRET="dev-secret-change-in-production-32chars-minimum-please"
AUTH_TRUST_HOST=true
# Must exactly match the domain the app is actually accessed at (with www, since
# that's what you're serving from) — a mismatch here breaks Auth.js's CSRF cookie
# validation (MissingCSRF errors on login).
# NEXTAUTH_URL=https://www.rspchitwan.org
#NODE_ENV=production
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded default accounts (see prisma/seed.ts) ---
# Only takes effect the FIRST time `make db-seed-production` runs and creates these
# accounts — changing these afterward does not change an already-created account's
# email/password (use the app's own "reset password" as admin, or "change password"
# in Profile, for that).
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=email@example.com
SEED_ADMIN_PASSWORD=password

SEED_USER_NAME=System User
SEED_USER_EMAIL=email@example.com
SEED_USER_PASSWORD=password
RUN_DB_PUSH=false
RUN_DB_SEED=false