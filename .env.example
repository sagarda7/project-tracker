DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel deployment (Postgres) ---
# Set these as Vercel project env vars, not here. DATABASE_URL should be a Postgres
# connection string (e.g. from Vercel Postgres or Neon), typically with sslmode=require:
#   DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
# AUTH_SECRET must be a real random value in production (`openssl rand -base64 32`).
# NEXTAUTH_URL should be the deployed https:// URL.
# RUN_DB_PUSH="true" — set for the first deploy only, to create tables via `prisma db push`
#   (uses prisma/schema.postgres.prisma); safe to leave unset/false afterwards.
# RUN_DB_SEED="true" — set to seed the default admin/user accounts (see prisma/seed.ts);
#   also safe to unset after the first successful deploy.

# Optional — override the seeded default admin/user accounts (see prisma/seed.ts).
# Only takes effect the first time an account with that email is seeded; changing
# these after the account already exists does not change its email/password.
# SEED_ADMIN_NAME="System Administrator"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="admin123"
# SEED_USER_NAME="Field Engineer"
# SEED_USER_EMAIL="user@example.com"
# SEED_USER_PASSWORD="user123"
