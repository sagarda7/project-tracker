generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Language {
  EN
  NE
}

enum ProjectStatus {
  PLANNED
  BID
  STARTED
  PROGRESS
  HALTED
  CANCELED
  COMPLETED
  HANDOVER
}

enum GoverningBody {
  METROPOLITAN_CITY
  SUB_METROPOLITAN_CITY
  MUNICIPALITY
  RURAL_MUNICIPALITY
  URBAN_DEVELOPMENT
  INFRASTRUCTURE_DEVELOPMENT
  OTHER
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String?
  passwordHash String
  role      Role     @default(USER)
  language  Language @default(EN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects Project[]             @relation("ProjectCreatedBy")
  followupNotes   ProjectFollowupNote[] @relation("NoteCreatedBy")
  statusChanges   ProjectStatusHistory[] @relation("StatusChangedBy")
  csvImports      CsvImportLog[]        @relation("ImportCreatedBy")

  @@index([email])
  @@index([role])
}

model Contractor {
  id            String   @id @default(cuid())
  name          String
  companyName   String?
  phone         String
  alternatePhone String?
  email         String?
  address       String?
  contactPerson String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]

  @@index([name])
  @@index([phone])
}

model Project {
  id                  String        @id @default(cuid())
  name                String
  province             String
  district             String
  municipality         String
  ward                 String
  locationDescription  String?
  contractorId         String?
  contractorName       String?
  contractorPhone      String?
  contactPersonName    String?
  contactPersonPhone   String?
  governingBody        GoverningBody
  status               ProjectStatus @default(PLANNED)
  budget               Float
  startDate            DateTime?
  deadline             DateTime?
  description          String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contractor      Contractor?             @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  createdBy       User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  images          ProjectImage[]
  followupNotes   ProjectFollowupNote[]
  statusHistory   ProjectStatusHistory[]

  @@index([name])
  @@index([status])
  @@index([province])
  @@index([district])
  @@index([deadline])
  @@index([contractorId])
}

model ProjectImage {
  id         String   @id @default(cuid())
  projectId  String
  fileName   String
  filePath   String
  mimeType   String
  fileSize   Int
  caption    String?
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFollowupNote {
  id               String   @id @default(cuid())
  projectId        String
  note             String
  followupDate     DateTime?
  proofImagePath   String?
  externalLink     String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([followupDate])
}

model ProjectStatusHistory {
  id            String        @id @default(cuid())
  projectId     String
  previousStatus ProjectStatus?
  newStatus     ProjectStatus
  changedById   String
  comment       String?
  changedAt     DateTime      @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User    @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([changedAt])
}

model CsvImportLog {
  id            String   @id @default(cuid())
  entityType    String
  fileName      String
  totalRows     Int
  successCount  Int
  errorCount    Int
  errors        String?
  createdById   String
  createdAt     DateTime @default(now())

  createdBy User @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([entityType])
  @@index([createdAt])
}
