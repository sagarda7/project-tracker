# Copy to .env.production (same folder) and fill in real values.

# Run `docker network ls` on the server to find this — it's the other compose
# project's name + "_shared_network".
SHARED_NETWORK_NAME=changeme_shared_network

# "mariadb" is the container name on the shared network. The target database must
# already exist — Prisma won't create it, only its tables.
DATABASE_URL=mysql://user:password@mariadb:3306/dbname

# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme
# Required for self-hosted (non-Vercel) deployments — see auth.ts.
AUTH_TRUST_HOST=true

NEXTAUTH_URL=https://your-real-domain.example
NODE_ENV=production

# --- Seeded default accounts (see prisma/seed.ts) ---
# Set these before the FIRST `make db-seed-production` run — changing them after the
# account already exists has no effect on it.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@your-real-domain.example
SEED_ADMIN_PASSWORD=changeme
