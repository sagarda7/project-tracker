# Copy to .env.staging (same folder) and fill in real values.

SHARED_NETWORK_NAME=changeme_shared_network
DATABASE_URL=mysql://user:password@mariadb:3306/rspchitwan_staging

# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme
# Required for self-hosted (non-Vercel) deployments — see auth.ts.
AUTH_TRUST_HOST=true

NEXTAUTH_URL=https://staging.your-real-domain.example
# Next.js only understands production/development/test — always "production" here,
# even for the staging environment.
NODE_ENV=production

# --- Seeded default accounts (see prisma/seed.ts) ---
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@your-real-domain.example
SEED_ADMIN_PASSWORD=changeme
