# Real values for the staging deployment. Gitignored — never commit this file.

# --- Database ---
# DB_PROVIDER picks which Prisma schema/client this image is built with — "mysql" (default)
# or "postgres". This is read at BUILD time (docker-compose passes it through as a build arg —
# see docker-compose.yml), so changing it requires `make build-staging` again, not just a
# container restart.
DB_PROVIDER=mysql

# --- Option A: mysql — existing shared MariaDB (from your other compose stack) ---
# Run `docker network ls` on the server and put the real network name here —
# it's the other stack's compose project name + "_shared_network". Only needed when
# DB_PROVIDER=mysql (a managed Postgres host doesn't live on this network).
SHARED_NETWORK_NAME=wordpress-docker_shared_network

# mariadb has no host-published port; "mariadb" below is the container name, resolved
# via the shared Docker network. Make sure the `rspchitwan` database itself already
# exists in that MariaDB instance — Prisma won't create the database, only its tables.
#
# This currently connects as root (reusing MYSQL_ROOT_PASSWORD from the other stack).
# That works, but a dedicated user scoped to just this database is safer since this
# app's credentials would otherwise be a root key to every database on that server
# (including the WordPress sites). See README "Docker Deployment" for the one-time
# SQL to create one — swap it in here when you get a chance.
DATABASE_URL=mysql://[user]:[password]@mariadb:3306/[dbname]

# --- Option B: postgres — any managed Postgres (Supabase, Neon, etc.) ---
# If the password itself contains special characters like @ : / ? #, percent-encode them
# (@ -> %40, : -> %3A, etc.) or the URL will parse into the wrong host/user/password.
# DATABASE_URL=postgresql://postgres:[url-encoded-password]@[host]:5432/[db]

# --- App ---
AUTH_SECRET=F5TNEOrt0oytI7+h+yYh/TpaU/DNBwtLJGcZHuAu240=
AUTH_TRUST_HOST=true
# Must exactly match the domain the app is actually accessed at (with www, since
# that's what you're serving from) — a mismatch here breaks Auth.js's CSRF cookie
# validation (MissingCSRF errors on login).
NEXTAUTH_URL=https://www.rspchitwan.org
NODE_ENV=production

# --- Seeded default accounts (see prisma/seed.ts) ---
# Only takes effect the FIRST time `make db-seed-production` runs and creates these
# accounts — changing these afterward does not change an already-created account's
# email/password (use the app's own "reset password" as admin, or "change password"
# in Profile, for that).
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=[email]
SEED_ADMIN_PASSWORD=[password]

SEED_USER_NAME=System User
SEED_USER_EMAIL=[email]
SEED_USER_PASSWORD=[password]
RUN_DB_PUSH=false
RUN_DB_SEED=false